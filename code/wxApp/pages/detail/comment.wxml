<view class="cu-card dynamic {{isCard?'no-card':''}}">
  <view class="cu-item shadow">
    <view class="cu-card dynamic {{isCard?'no-card':''}}">
      <view class="cu-item shadow">
        <view class="cu-list menu-avatar">
          <view class="cu-item">
            <view class="cu-avatar round lg" style="background-image:url({{forum.user.headimgUrl}});"></view>
            <view class="content flex-sub">
              <view>{{forum.user.name}}</view>
              <view class="text-gray text-sm flex justify-between">
                {{forum.time}}
              </view>
            </view>
          </view>
        </view>
        <view class="text-content">
          {{forum.info}}
        </view>
        <view class="grid flex-sub padding-lr {{isCard?'col-3 grid-square':'col-1'}}" catchtap="viewPic" data-pic="{{forum.picList}}">
          <view class="bg-img {{isCard?'':'only-img'}}" style="background-image:url({{item}});" wx:for="{{forum.picList}}" wx:key="{{index}}">
          </view>
        </view>
        <view class="text-gray text-sm text-right padding">
          <text class="cuIcon-attentionfill margin-lr-xs"></text> {{forum.view}}
          <text class="cuIcon-messagefill margin-lr-xs" catch:tap="addComment" data-id="{{forum.id}}" data-commentId="0"></text> {{forum.comment}}
        </view>
      </view>
    </view>
    <view class="cu-list menu-avatar comment solids-top">
      <view class="cu-item" wx:for="{{forum.evaluations}}" wx:key="index">
        <view class="cu-avatar round" style="background-image:url({{item.evUser.headimgUrl}});"></view>
        <view class="content">
          <view class="text-grey">{{item.evUser.name}}:</view>
          <view class="text-gray text-content text-df">
           {{item.content}}
          </view>
          <!--回复的东西-->
          <view class="bg-grey padding-sm radius margin-top-sm  text-sm" wx:if="{{item.replyId!=null}}">
            <view class="flex">
              <view>{{item.reUser.name}}</view>
              <view class="flex-sub">{{item.replyContent}}</view>
            </view>
          </view>
          <view class="margin-top-sm flex justify-between">
            <view class="text-gray text-df">{{item.time}}</view>
            <view>
              <text class="cuIcon-messagefill text-gray margin-left-sm" wx:if="{{item.replyId==null}}"catch:tap="addComment" data-id="{{forum.id}}" data-commentId="{{item.id}}" ></text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>