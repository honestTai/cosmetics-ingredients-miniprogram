<view class="cu-bar search bg-white fixed" style="box-shadow:none">
  <view class="search-form round">
    <view class="search-form round">
      <text class="cuIcon-search"></text>
      <input type="text" placeholder="搜索文章内容" confirm-type="search" bindconfirm="searchHandle" focus></input>
    </view>
    <view class="action">
      <navigator class="response" hover-class='none' url='/pages/fourmadd/add'>
        <button class="cu-btn bg-green shadow-blur round">发布动态</button>
      </navigator>
    </view>
  </view>
</view>
<view class="margin-top-bar bg-white">
  <!--动态-->
    <view class="cu-card dynamic {{isCard?'no-card':''}}" wx:for="{{fourmList}}" wx:key="index">
      <view class="cu-item shadow">
        <view class="cu-list menu-avatar">
          <view class="cu-item">
            <view class="cu-avatar round lg" style="background-image:url({{item.user.headimgUrl}});"></view>
            <view class="content flex-sub">
              <view>{{item.user.name}}</view>
              <view class="text-gray text-sm flex justify-between">
                {{item.time}}
              </view>
            </view>
          </view>
        </view>
        <view class="text-content">
          <navigator class="response" hover-class='none' url='../../pages/detail/comment?id={{item.id}}'>
            {{item.info}}
      </navigator>
         
        </view>
        <view class="grid flex-sub padding-lr {{isCard?'col-3 grid-square':'col-1'}}" catchtap="viewPic" data-pic="{{item.picList}}">
          <view class="bg-img {{isCard?'':'only-img'}}" style="background-image:url({{item}});" wx:for="{{item.picList}}" wx:key="{{index}}" >
          </view>
        </view>
        <view class="text-gray text-sm text-right padding">
          <text class="cuIcon-attentionfill margin-lr-xs"></text> {{item.view}}
          <text class="cuIcon-messagefill margin-lr-xs"></text> {{item.comment}}
        </view>
      </view>
    </view>

  <view class="cu-load bg-white {{loadmore?'loading':'over'}}"></view>
</view>